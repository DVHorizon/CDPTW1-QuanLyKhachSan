# ==========================================
# CẤU HÌNH BỎ QUA GHI NHẬN GIT (GITIGNORE)
# Dành cho Đồ Án Quản Lý Khách Sạn (Monorepo)
# ==========================================

# 1. Thư viện của Node.js (Sinh ra khi chạy npm install ở cả backend và frontend)
node_modules/

# 2. Cấu hình biến môi trường (Tuyệt đối KHÔNG push file chứa mật khẩu, database config lên Git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 3. Dữ liệu Cơ sở dữ liệu (MySQL Volume sinh ra khi chạy Docker)
mysql_data/

# 4. Các file Build sản phẩm của ReactJS (Vite) ở Frontend
dist/
dist-ssr/
build/

# 5. Các file log lỗi của hệ thống (Node.js, npm, yarn)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Các tệp rác do Hệ điều hành tự động sinh ra (Windows / macOS)
.DS_Store
Thumbs.db

# 7. Các tệp cấu hình của Code Editor/IDE cá nhân (VSCode, WebStorm, Visual Studio...)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. Tệp bộ nhớ đệm (cache) sinh ra trong quá trình phát triển
.npm
.eslintcache
.vite/