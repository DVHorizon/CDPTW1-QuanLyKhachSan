{
  "name": "hotel-management-backend",
  "version": "1.0.0",
  "description": "Backend API cho Đồ án Quản lý Khách sạn",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon -L src/server.js",
    "migrate": "sequelize-cli db:migrate",
    "seed": "node src/seeders/seedRunner.js",
    "seed:fast": "node src/seeders/seedRunner.js --count=1000",
    "seed:dev": "node src/seeders/seedRunner.js --count=10000",
    "seed:full": "node src/seeders/seedRunner.js --count=100000",
    "seed:legacy": "node src/seeders/seedAll.js",
    "verify:db": "node src/seeders/verifyTables.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^4.22.3",
    "fuse.js": "^7.5.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.9.0",
    "sequelize": "^6.37.0",
    "sqlite3": "^6.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "sequelize-cli": "^6.6.5"
  }
}
